{
  "name": "recipin",
  "version": "0.1.0",
  "description": "Recipin – ספר מתכונים אישי בסגנון פינטרסט, עם ייבוא חכם מלינק",
  "private": true,
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch server/index.js",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/*.test.js\"",
    "app:build": "node scripts/build-app.mjs && npx cap sync android"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "@capgo/capacitor-share-target": "^8.0.68",
    "cheerio": "^1.2.0",
    "express": "^4.22.3",
    "multer": "^2.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "esbuild": "^0.28.2",
    "linkedom": "^0.18.15"
  }
}
